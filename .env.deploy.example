APP_DOMAIN=biom.cloud-path.ru
POSTGRES_DB=credit_cabinet
POSTGRES_USER=credit_cabinet
# Заполните разными случайными hex-паролями перед первым запуском и seed
POSTGRES_PASSWORD=
DEMO_PASSWORD=
# Серверное дополнение Compose принудительно включает Secure-cookie
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800

# Необязательный помощник; без провайдера обычный кабинет продолжает работать
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
LLM_JSON_MODE=json_object
# Пусто = параметр reasoning не передаётся; true/false для OpenRouter и Польза AI
LLM_REASONING_ENABLED=

# OpenRouter: allow разрешает провайдеров, сохраняющих запросы; по умолчанию deny
LLM_DATA_COLLECTION=deny
# Польза AI: потолки тарифа в ₽/млн токенов; 0 отключает вызовы.
LLM_POLZA_MAX_PROMPT_RUB=0
LLM_POLZA_MAX_COMPLETION_RUB=0
